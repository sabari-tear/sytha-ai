# === REQUIRED ENVIRONMENT VARIABLES ===

# Google Gemini Configuration (FREE - for chat completions)
# Get your FREE API key from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Gemini Model Configuration (Optional - defaults shown)
# Available models: gemini-1.5-flash-latest (free), gemini-1.5-pro-latest, gemini-pro
GEMINI_MODEL=gemini-1.5-flash-latest

# HuggingFace Configuration (OPTIONAL - for embeddings)
# Works WITHOUT API key but with rate limits
# Get a FREE API key for higher limits from: https://huggingface.co/settings/tokens
HUGGINGFACE_API_KEY=hf_YOUR_OPTIONAL_API_KEY_HERE

# HuggingFace Embedding Model (Optional - defaults shown)
# Free model that works well for semantic search
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Pinecone Vector Database Configuration
# Sign up at: https://www.pinecone.io/
PINECONE_API_KEY=pcsk_YOUR_PINECONE_API_KEY_HERE
PINECONE_INDEX=legal-sections

# === OPTIONAL ENVIRONMENT VARIABLES ===

# Logging Configuration
# Options: DEBUG, INFO, WARN, ERROR, FATAL
LOG_LEVEL=INFO

# Node Environment
# Options: development, production, test
NODE_ENV=development

# === SECURITY NOTES ===
# 1. NEVER commit the actual .env file to version control
# 2. Rotate API keys regularly
# 3. Use different keys for development and production
# 4. Consider using a secrets management service in production